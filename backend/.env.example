# ==== Cortex backend 环境变量 ====

# HTTP 端口
PORT=8000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# SQLite 数据库文件（相对 backend/ 目录）
DB_PATH=cortex.db

# LLM 请求队列
LLM_MAX_CONCURRENT=5
LLM_REQUEST_TIMEOUT=60

# Wiki 整理/检索 agent 使用的 DeepSeek key（也可在管理后台配置主 LLM）
DEEPSEEK_API_KEY=

# 注意：主 LLM 的 base_url / api_key / model 在「管理后台 → 系统设置」中配置，
# 存于数据库 settings 表，无需写在这里。
